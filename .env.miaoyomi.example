# Generate .env with: python3 scripts/miaoyomi-config.py
# For your LXC, set the private address its existing reverse proxy can reach.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
# Both published Miaoyomi images use this same tag. Pin it to a release (for example v0.20.0) to update deliberately.
MIAOYOMI_IMAGE_TAG=latest
# Example on Proxmox: BIND_ADDRESS=10.0.0.25, PUBLIC_ORIGIN=https://read.example.com
PUID=10002
PGID=10002
MANGA_LIBRARY_PATH=./data/manga
MANGA_DOWNLOAD_PATH=./data/downloaded-manga
NOVEL_LIBRARY_PATH=./data/novels
# The config helper generates credentials and a properly URL-encoded DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
NOVEL_ENGINE_TOKEN=
# Optional JSON map of approved extra HTTPS origins per novel source. Blank keeps the built-in defaults.
# Setting it replaces the defaults; retain Royal Road's CDNs if you use that source.
# NOVEL_ENGINE_ALLOWED_ORIGINS='{"royalroad":["https://www.royalroadcdn.com","https://royalroadcdn.com"]}'
# Optional solver for novel challenges and upstream generic manga engines: --profile solver
# FLARESOLVERR_URL=http://solver:8191
